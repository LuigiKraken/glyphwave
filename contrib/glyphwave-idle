#!/bin/bash
# Open glyphwave fullscreen in a terminal, once. Idle daemons (hypridle,
# swayidle, xidlehook, KDE powerdevil) run this after the idle timeout.
#
# Terminal: $GLYPHWAVE_TERM, or the first installed of the list below.
# Konsole reads $GLYPHWAVE_KONSOLE_PROFILE (e.g. a black, borderless profile).
#
#   glyphwave-idle          open the screensaver (no-op if it's already up)
#   glyphwave-idle --stop   close it; run this before a Wayland locker

if [[ $1 == --stop ]]; then
  pkill -f -- '^[^ ]*glyphwave --screensaver'
  exit 0
fi

# never under a lock screen; the bus lockers (KDE, GNOME) glyphwave checks itself
pgrep -x 'hyprlock|swaylock|waylock|gtklock|i3lock|xsecurelock' >/dev/null && exit 0
pgrep -f -- '^[^ ]*glyphwave --screensaver' >/dev/null && exit 0

bin=$(command -v glyphwave || echo "$HOME/.local/bin/glyphwave")
run=("$bin" --screensaver)

term=$GLYPHWAVE_TERM
if [[ -z $term ]]; then
  for t in kitty foot alacritty ghostty wezterm konsole xterm; do
    command -v "$t" >/dev/null && { term=$t; break; }
  done
fi

case $term in
  kitty)     cmd=(kitty --class glyphwave --start-as=fullscreen -o background=#000000 "${run[@]}") ;;
  foot)      cmd=(foot --app-id=glyphwave --fullscreen -o colors.background=000000 "${run[@]}") ;;
  alacritty) cmd=(alacritty --class glyphwave -o 'window.startup_mode="Fullscreen"' -o 'colors.primary.background="#000000"' -e "${run[@]}") ;;
  ghostty)   cmd=(ghostty --fullscreen=true --background=000000 -e "${run[@]}") ;;
  wezterm)   cmd=(wezterm start --class glyphwave -- "${run[@]}") ;;  # fullscreen via the window rule
  konsole)   cmd=(konsole ${GLYPHWAVE_KONSOLE_PROFILE:+--profile "$GLYPHWAVE_KONSOLE_PROFILE"} --fullscreen --hide-menubar --hide-tabbar --notransparency -e "${run[@]}") ;;
  xterm)     cmd=(xterm -class glyphwave -fullscreen -bg black -e "${run[@]}") ;;
  *)         echo "glyphwave-idle: no terminal found; set GLYPHWAVE_TERM" >&2; exit 1 ;;
esac

# flock keeps two idle timers from opening two windows; released on exit
exec flock -n "${XDG_RUNTIME_DIR:-/tmp}/glyphwave-idle.lock" "${cmd[@]}"
